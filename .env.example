# ============================================================
# AquilaCyber CTF Platform — Environment Variables
# ============================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ============================================================

# Server
NODE_ENV=development
PORT=3000

# Session
SESSION_SECRET=change_me_to_a_strong_random_string

# JWT Secret (used by the Vault challenge)
JWT_SECRET=super_secret_jwt_key

# Database persistence path
# For Docker:  DB_PATH=/app/data-persist/aquila.json
# For Local:   DB_PATH=./aquila.json  (or leave unset for default)
DB_PATH=./aquila.json
