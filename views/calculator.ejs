<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Calculator</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>

<body>
    <div class="container">
        <a href="/" class="btn" style="margin-bottom: 20px; display: inline-block;">&larr; Dashboard</a>

        <div class="glass-panel">
            <h2>Quantum Calculator</h2>
            <p style="opacity: 0.7; margin-bottom: 20px;">Perform complex calculations on our supercomputer.</p>

            <form action="/challenge/calculator" method="POST" style="display: flex; gap: 10px;">
                <input type="text" name="expression" placeholder="e.g., 2 + 2 * 4" style="margin-bottom: 0;">
                <button type="submit" class="btn">Calculate</button>
            </form>

            <% if (result !==null) { %>
                <div
                    style="margin-top: 20px; background: #000; padding: 20px; border-radius: 8px; border: 1px solid var(--glass-border); font-family: var(--font-code);">
                    <h3 style="color: var(--accent-primary); font-size: 0.9rem; margin-bottom: 10px;">> CALCULATION
                        RESULT</h3>
                    <pre style="margin: 0; white-space: pre-wrap; color: #ccc;"><%= result %></pre>
                </div>
                <% } %>
        </div>

        <div class="glass-panel" style="margin-top: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <span class="hint-title" style="font-weight: 600; color: var(--warning);">💡 MISSION HINT</span>
                <button id="getHintBtn" class="btn" style="border-color: var(--warning); color: var(--warning); padding: 6px 12px; font-size: 0.85rem;" data-challenge-id="6">Get Hint (-20 pts)</button>
            </div>
            <div id="hintContainer">
                <p style="opacity: 0.6; margin: 0; font-size: 0.9rem;">Hints are progressive. Using a hint reduces your maximum possible score.</p>
            </div>
        </div>

        <%- include('partials/hint_script') %>
    </div>
</body>

</html>