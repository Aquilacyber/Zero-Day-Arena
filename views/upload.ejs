<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Manager - Upload</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>

<body class="has-nav">
<%- include('partials/nav', {
    user: locals.user || '',
    score: locals.score || 0,
    currentPage: 'ch-8',
    isAdmin: locals.isAdmin || false
}) %>

<%- include('partials/challenge_header', {
    challengeId: 8,
    challengeName: 'File Manager',
    challengeType: 'File Upload',
    challengeDifficulty: 'Easy',
    challengePoints: 100,
    challengeSolved: false
}) %>


    <div class="container">
        <h1>File Manager</h1>
        <p style="color: var(--text-secondary);">File Upload Challenge - Upload files to the server</p>

        <div class="glass-panel" style="margin-top: 30px;">
            <% if (message) { %>
                <div
                    style="padding: 12px; background: rgba(0, 255, 136, 0.1); border: 1px solid var(--accent); border-radius: 4px; margin-bottom: 20px;">
                    <%= message %>
                </div>
                <% } %>

                    <form method="POST" action="/challenge/upload" enctype="multipart/form-data">
                        <label>Select File</label>
                        <input type="file" name="file" required
                            style="background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-primary); padding: 12px; width: 100%; border-radius: 3px; margin-bottom: 16px;">

                        <button type="submit" class="btn">Upload File</button>
                    </form>

                    <div class="glass-panel" style="margin-top: 30px; padding: 20px; background: rgba(255, 170, 0, 0.1); border: 1px solid var(--warning); border-radius: 4px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                            <span class="hint-title" style="font-weight: 600; color: var(--warning);">💡 MISSION HINT</span>
                            <button id="getHintBtn" class="btn" style="border-color: var(--warning); color: var(--warning); padding: 6px 12px; font-size: 0.85rem;" data-challenge-id="8">Get Hint (-20 pts)</button>
                        </div>
                        <div id="hintContainer">
                            <p style="opacity: 0.6; margin: 0; font-size: 0.9rem;">Hints are progressive. Using a hint reduces your maximum possible score.</p>
                        </div>
                    </div>

                    <%- include('partials/hint_script') %>
        </div>

        <a href="/" class="btn" style="margin-top: 20px;">← Back to Dashboard</a>
    </div>
</body>

</html>