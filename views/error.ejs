<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Aquila CTF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .error-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            text-align: center;
        }

        .error-code {
            font-size: 8rem;
            font-weight: 800;
            line-height: 1;
            background: linear-gradient(135deg, var(--accent), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            opacity: 0;
            animation: errorSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        .error-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            filter: grayscale(0.3);
            opacity: 0;
            animation: errorSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards;
        }

        .error-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--text-primary);
            opacity: 0;
            animation: errorSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.2s forwards;
        }

        .error-message {
            font-size: 1.05rem;
            color: var(--text-secondary);
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 36px;
            opacity: 0;
            animation: errorSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
        }

        .error-actions {
            display: flex;
            gap: 12px;
            opacity: 0;
            animation: errorSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.4s forwards;
        }

        .error-detail {
            margin-top: 40px;
            padding: 16px 24px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
            opacity: 0;
            animation: errorSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.5s forwards;
        }

        .error-detail code {
            color: var(--accent);
        }

        @keyframes errorSlideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Floating particles background effect */
        .error-bg-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }

        .error-bg-particles::before,
        .error-bg-particles::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            animation: floatParticle 8s ease-in-out infinite;
        }

        .error-bg-particles::before {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(0, 242, 254, 0.06), transparent 70%);
            top: 20%;
            left: 10%;
        }

        .error-bg-particles::after {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(184, 41, 234, 0.06), transparent 70%);
            bottom: 10%;
            right: 10%;
            animation-delay: -4s;
        }

        @keyframes floatParticle {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(30px, -30px); }
        }
    </style>
</head>

<body>
    <div class="error-bg-particles"></div>
    <div class="container">
        <div class="error-container">
            <div class="error-code"><%= statusCode %></div>
            <div class="error-icon"><%= icon %></div>
            <h1 class="error-title"><%= title %></h1>
            <p class="error-message"><%= message %></p>

            <div class="error-actions">
                <a href="/" class="btn btn-primary">← Back to Dashboard</a>
                <% if (statusCode === 403 && locals.challengeId) { %>
                    <a href="/challenge/<%= locals.challengeSlug || '' %>" class="btn">Go to Challenge</a>
                <% } %>
            </div>

            <% if (locals.detail) { %>
                <div class="error-detail">
                    <code><%= detail %></code>
                </div>
            <% } %>
        </div>
    </div>
</body>

</html>
