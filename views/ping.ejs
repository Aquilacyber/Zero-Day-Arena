<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Network Tool</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>

<body class="has-nav">
<%- include('partials/nav', {
    user: locals.user || '',
    score: locals.score || 0,
    currentPage: 'ch-4',
    isAdmin: locals.isAdmin || false
}) %>

<%- include('partials/challenge_header', {
    challengeId: 4,
    challengeName: 'Ping Tool',
    challengeType: 'Cmd Injection',
    challengeDifficulty: 'Medium',
    challengePoints: 100,
    challengeSolved: false
}) %>


    <div class="container">
        <a href="/" class="btn" style="margin-bottom: 20px; display: inline-block;">&larr; Dashboard</a>

        <div class="glass-panel">
            <h2>Network Connectivity Tool</h2>
            <p style="opacity: 0.7; margin-bottom: 20px;">Ping an IP address to verify network status.</p>

            <form action="/challenge/ping" method="POST" style="display: flex; gap: 10px;">
                <input type="text" name="ip" placeholder="e.g., 8.8.8.8" style="margin-bottom: 0;">
                <button type="submit" class="btn">Ping Host</button>
            </form>

            <% if (output) { %>
                <div
                    style="margin-top: 20px; background: #000; padding: 20px; border-radius: 8px; border: 1px solid var(--glass-border); font-family: var(--font-code);">
                    <h3 style="color: var(--accent-primary); font-size: 0.9rem; margin-bottom: 10px;">> TERMINAL OUTPUT
                    </h3>
                    <pre style="margin: 0; white-space: pre-wrap; color: #ccc;"><%= output %></pre>
                </div>
                <% } %>
        </div>

        <div class="glass-panel" style="margin-top: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <span class="hint-title" style="font-weight: 600; color: var(--warning);">💡 MISSION HINT</span>
                <button id="getHintBtn" class="btn" style="border-color: var(--warning); color: var(--warning); padding: 6px 12px; font-size: 0.85rem;" data-challenge-id="4">Get Hint (-20 pts)</button>
            </div>
            <div id="hintContainer">
                <p style="opacity: 0.6; margin: 0; font-size: 0.9rem;">Hints are progressive. Using a hint reduces your maximum possible score.</p>
            </div>
        </div>

        <%- include('partials/hint_script') %>
    </div>
</body>

</html>