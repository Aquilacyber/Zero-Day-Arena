<!DOCTYPE html>
<html lang="en">

<head>
    <script>/* inline theme - no FOUC */
    (function(){var t=localStorage.getItem('theme')||'dark';document.documentElement.setAttribute('data-theme',t);})();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Login</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>

<body class="has-nav">
<%- include('partials/nav', {
    user: locals.user || '',
    score: locals.score || 0,
    currentPage: 'ch-1',
    isAdmin: locals.isAdmin || false
}) %>

<%- include('partials/challenge_header', {
    challengeId: 1,
    challengeName: 'Login Bypass',
    challengeType: 'SQL Injection',
    challengeDifficulty: 'Easy',
    challengePoints: 100,
    challengeSolved: false
}) %>


    <div class="container">
        <a href="/" class="btn" style="margin-bottom: 20px; display: inline-block;">&larr; Dashboard</a>

        <div class="glass-panel" style="max-width: 500px; margin: 0 auto;">
            <h2 style="text-align: center; margin-bottom: 30px;">Admin Authentication</h2>

            <% if (error) { %>
                <div
                    style="background: rgba(255, 0, 85, 0.2); border: 1px solid var(--accent-secondary); color: #fff; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                    ⚠ ACCESS DENIED: <%= error %>
                </div>
                <% } %>

                    <% if (locals.success) { %>
                        <div
                            style="background: rgba(0, 242, 255, 0.2); border: 1px solid var(--accent-primary); color: #fff; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                            ✔ ACCESS GRANTED: <%= success %>
                        </div>
                        <% } %>

                            <form action="/challenge/login" method="POST">
                                <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Username</label>
                                <input type="text" name="username" placeholder="Enter username...">

                                <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Password</label>
                                <input type="password" name="password" placeholder="Enter password...">

                                <button type="submit" class="btn"
                                    style="width: 100%; margin-top: 10px;">Authenticate</button>
                            </form>
        </div>

        <div class="glass-panel" style="max-width: 500px; margin: 20px auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <span class="hint-title" style="font-weight: 600; color: var(--warning);">💡 MISSION HINT</span>
                <button id="getHintBtn" class="btn" style="border-color: var(--warning); color: var(--warning); padding: 6px 12px; font-size: 0.85rem;" data-challenge-id="1">Get Hint (-20 pts)</button>
            </div>
            <div id="hintContainer">
                <p style="opacity: 0.6; margin: 0; font-size: 0.9rem;">Hints are progressive. Using a hint reduces your maximum possible score.</p>
            </div>
        </div>

        <%- include('partials/hint_script') %>
    </div>
</body>

</html>