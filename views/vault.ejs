<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Vault</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>

<body>
    <div class="container">
        <a href="/" class="btn" style="margin-bottom: 20px; display: inline-block;">&larr; Dashboard</a>

        <div class="glass-panel">
            <h2>Top Secret Vault</h2>
            <p style="opacity: 0.7; margin-bottom: 20px;">Authorized personnel only. Biometric scan required.</p>

            <% if (locals.error) { %>
                <div
                    style="background: rgba(255, 0, 85, 0.2); border: 1px solid var(--accent-secondary); color: #fff; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                    ⚠ ACCESS DENIED: <%= error %>
                </div>
                <% } %>

                    <div style="background: rgba(0, 0, 0, 0.2); border-radius: 8px; padding: 20px;">
                        <p><strong>Identity:</strong>
                            <%= user.username %>
                        </p>
                        <p><strong>Clearance Level:</strong>
                            <%= user.role %>
                        </p>

                        <% if (flag) { %>
                            <div
                                style="background: rgba(0, 242, 255, 0.1); border: 1px dashed var(--accent-primary); padding: 15px; border-radius: 8px; margin-top: 20px;">
                                <strong style="color: var(--accent-primary);">VAULT UNLOCKED:</strong>
                                <code style="margin-left: 10px;"><%= flag %></code>
                            </div>
                            <% } else { %>
                                <div
                                    style="margin-top: 20px; opacity: 0.5; border-top: 1px solid var(--glass-border); padding-top: 10px;">
                                    <p>Vault content is encrypted. Admin clearance required.</p>
                                </div>
                                <% } %>
                    </div>
        </div>

        <div class="glass-panel" style="margin-top: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <span class="hint-title" style="font-weight: 600; color: var(--warning);">💡 MISSION HINT</span>
                <button id="getHintBtn" class="btn" style="border-color: var(--warning); color: var(--warning); padding: 6px 12px; font-size: 0.85rem;" data-challenge-id="5">Get Hint (-20 pts)</button>
            </div>
            <div id="hintContainer">
                <p style="opacity: 0.6; margin: 0; font-size: 0.9rem;">Hints are progressive. Using a hint reduces your maximum possible score.</p>
            </div>
        </div>

        <%- include('partials/hint_script') %>
    </div>
</body>

</html>