<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Aquila CTF</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
    <style>
        .team-options { display: flex; gap: 8px; margin-bottom: 16px; }
        .team-opt {
            flex: 1; padding: 10px 8px; border: 1px solid var(--border);
            border-radius: 8px; background: var(--bg-secondary);
            cursor: pointer; text-align: center; font-size: 0.82rem;
            font-weight: 600; color: var(--text-secondary);
            transition: all 0.18s; font-family: var(--font-sans);
        }
        .team-opt:hover { border-color: var(--accent); color: var(--accent); }
        .team-opt.active { border-color: var(--accent); background: rgba(56,189,248,0.08); color: var(--accent); }
        .team-opt.active-create { border-color: var(--success); background: rgba(0,230,118,0.08); color: var(--success); }
        .team-opt.active-join   { border-color: var(--warning); background: rgba(255,234,0,0.08); color: var(--warning); }
        .team-panel { display: none; margin-top: 4px; }
        .team-panel.show { display: block; }
        .team-code-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; }
    </style>
</head>
<body>
<div class="container" style="max-width:420px; margin-top:80px;">
    <h1 style="text-align:center; margin-bottom:28px;">Create Account</h1>

    <div class="glass-panel">
        <% if (error) { %>
        <div style="padding:12px; background:rgba(255,68,68,0.1); border:1px solid var(--danger);
            border-radius:6px; margin-bottom:18px; color:var(--danger); font-size:0.88rem;">
            <%= error %>
        </div>
        <% } %>

        <form method="POST" action="/auth/register" id="regForm">
            <input type="hidden" name="team_action" id="teamActionInput" value="none">

            <label>Username</label>
            <input type="text" name="username" required autocomplete="username"
                minlength="3" maxlength="24" placeholder="3–24 chars, letters/numbers/_-">

            <label>Password</label>
            <input type="password" name="password" required autocomplete="new-password"
                minlength="6" placeholder="Min 6 characters">

            <!-- Team Section -->
            <div style="margin-top:20px; margin-bottom:4px;">
                <label style="margin-bottom:8px; display:block;">Team <span style="color:var(--text-muted); font-weight:400; font-size:0.8rem;">(optional)</span></label>
                <div class="team-options">
                    <button type="button" class="team-opt" id="optNone"   onclick="setTeamMode('none')">Solo</button>
                    <button type="button" class="team-opt" id="optCreate" onclick="setTeamMode('create')">Create Team</button>
                    <button type="button" class="team-opt" id="optJoin"   onclick="setTeamMode('join')">Join Team</button>
                </div>
            </div>

            <!-- Create team panel -->
            <div class="team-panel" id="panelCreate">
                <label>Team Name</label>
                <input type="text" name="team_name" id="teamNameInput" maxlength="32"
                    placeholder="Your team name (max 32 chars)" autocomplete="off">
                <div class="team-code-hint">A join code will be generated — share it with teammates.</div>
            </div>

            <!-- Join team panel -->
            <div class="team-panel" id="panelJoin">
                <label>Team Code</label>
                <input type="text" name="team_code" id="teamCodeInput" maxlength="6"
                    placeholder="6-character code e.g. A3F9B2" autocomplete="off"
                    style="font-family:var(--font-mono); letter-spacing:0.12em; text-transform:uppercase;">
                <div class="team-code-hint">Ask your team captain for the join code.</div>
            </div>

            <button type="submit" class="btn" style="width:100%; margin-top:20px;">Create Account</button>
        </form>

        <p style="text-align:center; margin-top:18px; color:var(--text-secondary); font-size:0.88rem;">
            Already have an account? <a href="/auth/login" style="color:var(--accent);">Login</a>
        </p>
    </div>
</div>

<script>
function setTeamMode(mode) {
    document.getElementById('teamActionInput').value = mode;
    document.querySelectorAll('.team-opt').forEach(b => b.classList.remove('active', 'active-create', 'active-join'));
    document.querySelectorAll('.team-panel').forEach(p => p.classList.remove('show'));

    if (mode === 'none') {
        document.getElementById('optNone').classList.add('active');
        document.getElementById('teamNameInput').removeAttribute('required');
        document.getElementById('teamCodeInput').removeAttribute('required');
    } else if (mode === 'create') {
        document.getElementById('optCreate').classList.add('active-create');
        document.getElementById('panelCreate').classList.add('show');
        document.getElementById('teamNameInput').setAttribute('required', '');
        document.getElementById('teamCodeInput').removeAttribute('required');
    } else if (mode === 'join') {
        document.getElementById('optJoin').classList.add('active-join');
        document.getElementById('panelJoin').classList.add('show');
        document.getElementById('teamCodeInput').setAttribute('required', '');
        document.getElementById('teamNameInput').removeAttribute('required');
    }
}
// Default: solo
setTeamMode('none');

// Force team code to uppercase as user types
document.getElementById('teamCodeInput').addEventListener('input', function() {
    this.value = this.value.toUpperCase();
});
</script>
</body>
</html>
