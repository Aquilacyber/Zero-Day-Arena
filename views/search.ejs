<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Search</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>

<body class="has-nav">
<%- include('partials/nav', {
    user: locals.user || '',
    score: locals.score || 0,
    currentPage: 'ch-2',
    isAdmin: locals.isAdmin || false
}) %>

<%- include('partials/challenge_header', {
    challengeId: 2,
    challengeName: 'XSS Search',
    challengeType: 'Reflected XSS',
    challengeDifficulty: 'Easy',
    challengePoints: 100,
    challengeSolved: false
}) %>


    <div class="container">
        <a href="/" class="btn" style="margin-bottom: 20px; display: inline-block;">&larr; Dashboard</a>

        <div class="glass-panel">
            <h2>Employee Database Search</h2>
            <p style="opacity: 0.7; margin-bottom: 20px;">Enter a name to search the internal directory.</p>

            <form action="/challenge/search" method="GET" style="display: flex; gap: 10px;">
                <input type="text" name="q" placeholder="Search query..." value="<%= query %>"
                    style="margin-bottom: 0;">
                <button type="submit" class="btn">Search</button>
            </form>

            <% if (query) { %>
                <div style="margin-top: 30px; border-top: 1px solid var(--glass-border); padding-top: 20px;">
                    <h3>Results for: <span style="color: var(--accent-primary);"><%- query %></span></h3>
                    <p style="opacity: 0.6;">No matching records found in the current shard.</p>
                </div>
                <% } %>
        </div>

        <div class="glass-panel" style="margin-top: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <span class="hint-title" style="font-weight: 600; color: var(--warning);">💡 MISSION HINT</span>
                <button id="getHintBtn" class="btn" style="border-color: var(--warning); color: var(--warning); padding: 6px 12px; font-size: 0.85rem;" data-challenge-id="2">Get Hint (-20 pts)</button>
            </div>
            <div id="hintContainer">
                <p style="opacity: 0.6; margin: 0; font-size: 0.9rem;">Hints are progressive. Using a hint reduces your maximum possible score.</p>
            </div>
        </div>

        <%- include('partials/hint_script') %>
    </div>
</body>

</html>